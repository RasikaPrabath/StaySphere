# StaySphere Enterprise Environment Configuration

# Application
ASPNETCORE_ENVIRONMENT=Development
PORT=5000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=staysphere_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
DATABASE_URL=Host=localhost;Port=5432;Database=staysphere_db;Username=postgres;Password=postgres_secure_pass_2026

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=localhost:6379

# JWT Security
JWT_SECRET=StaySphere_Super_Secret_Enterprise_JWT_Key_2026_Must_Be_At_Least_32_Chars!
JWT_ISSUER=StaySphereAPI
JWT_AUDIENCE=StaySphereClients
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Gateways
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYHERE_MERCHANT_ID=123456
PAYHERE_SECRET=your-payhere-secret

# File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=staysphere-media-storage
CLOUDINARY_CLOUD_NAME=staysphere
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Email Service
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@staysphere.com
